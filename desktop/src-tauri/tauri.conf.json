{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "hi3",
  "version": "0.1.0",
  "identifier": "dev.hi3.preview",
  "build": { "beforeBuildCommand": "bun run build", "frontendDist": "../dist" },
  "app": {
    "windows": [{ "label": "main", "title": "hi3", "width": 1120, "height": 760, "minWidth": 640, "minHeight": 400, "fullscreen": true }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'" }
  },
  "bundle": {
    "active": true, "targets": ["app"], "icon": ["icons/icon.icns", "icons/icon.png"],
    "resources": { "runtime/herdr": "runtime/herdr" },
    "macOS": { "minimumSystemVersion": "13.0", "signingIdentity": "-" },
    "shortDescription": "Isolated Herdr terminal preview",
    "category": "DeveloperTool"
  }
}
